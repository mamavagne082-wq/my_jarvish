# ===============================================================
# JARVIS AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# This template is safe to commit to Git.
# ===============================================================

# LiveKit Cloud Credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API Key (https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude API Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BACKUP_1=

# Xiaomi MiMo API Key (https://mimo.xiaomi.com)
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key
MIMO_API_KEY=your_xiaomi_mimo_api_key

# ElevenLabs Voice TTS API Key (https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Meta AI / Llama API Key
META_AI_API_KEY=your_meta_ai_api_key
META_AI_BACKUP_1=

# FastRouter API Key
FAST_ROUTER_API_KEY=your_fast_router_api_key
FAST_ROUTER_BACKUP_1=

# Mem0 AI Memory API Key (https://mem0.ai)
MEM0_API_KEY=your_mem0_api_key

# Google Search & Custom Search Engine ID
GOOGLE_SEARCH_KEY=your_google_search_client_id
SEARCH_ENGINE_ID=your_custom_search_engine_id

# OpenWeather API Key (https://openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key

# Security & Identity
PC_BRIDGE_AUTH_PIN=123456
JARVIS_USER_NAME=User
JARVIS_ASSISTANT_NAME=Jarvis
LOCATION=Dhaka, Bangladesh
